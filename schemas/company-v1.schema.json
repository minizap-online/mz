{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MZ company configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S",
      "not": { "pattern": "\\s$" }
    }
  }
}
